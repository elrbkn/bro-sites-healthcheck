# ==== proxy ====
SOAX_HOST=proxy.soax.com
SOAX_PORT=5000
SOAX_LOGIN_PREFIX=package-XXXXXX-country
SOAX_LOGIN_SUFFIX=opt-lookalike
SOAX_PASSWORD=your_soax_password

PROXY_COUNTRY=de
PROXY_ROTATE_SESSION=true

# ==== Telegram ====
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_PROXY_URL=

# ==== Health check настройки ====
PAGE_TIMEOUT_MS=30000
RETRY_COUNT=1
CONCURRENCY=3
MIN_CONTENT_LENGTH=50

# Дополнительно проверять сайт с мобильным viewport (iPhone)
MOBILE_CHECK_ENABLED=true

# ==== Уведомления: только при изменениях + ежедневная сводка ====
STATE_FILE_PATH=state/last-status.json
DAILY_SUMMARY_HOUR=11
REPORT_TIMEZONE=Europe/Riga
